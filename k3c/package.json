{
  "name": "k3c",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "cross-env NODE_ENV=development node server.js",
    "start": "node server.js",
    "typecheck": "react-router typegen && tsc -b",
    "lint": "npm run lint:prettier && npm run lint:eslint",
    "lint:prettier": "prettier --check .",
    "lint:eslint": "eslint .",
    "lint:fix": "npm run lint:prettier:fix && npm run lint:eslint:fix",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:fix": "eslint . --fix",
    "test": "docker compose --profile=essential --env-file=.env.local up -d && sleep 15 && (POSTGRES_APP_DB=unittest vitest run --project unit-tests)",
    "test:watch": "docker compose --profile=essential --env-file=.env.local up -d && (POSTGRES_APP_DB=unittest vitest --project unit-tests)",
    "test:browser": "vitest run --project component-tests --config=vite.config.ts",
    "test:browser:watch": "vitest --project component-tests --config=vite.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:watch": "playwright test --ui",
    "precommit": "lint-staged && npm run typecheck && npm run dependency-check",
    "dependency-check": "npx depcruise . --include-only app -x '(node_modules|\\.react-router|.+[.]js)' --output-type err-long",
    "prepare": "cd .. && husky k3c/.husky || true",
    "generate-rest-client": "openapi-generator-cli generate -i http://localhost:8089/q/openapi.json -g typescript-fetch -o app/.server/cost-control/rest"
  },
  "dependencies": {
    "@mantine/core": "^8.3.14",
    "@mantine/dates": "^8.3.14",
    "@mantine/dropzone": "^8.3.14",
    "@mantine/form": "^8.3.14",
    "@mantine/hooks": "^8.3.14",
    "@mantine/notifications": "^8.3.14",
    "@react-router/express": "7.14.0",
    "@react-router/node": "7.14.0",
    "@remix-run/form-data-parser": "^0.15.0",
    "@tabler/icons-react": "^3.36.1",
    "compression": "^1.8.1",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "isbot": "^5.1.31",
    "jose": "^6.1.3",
    "mantine-form-zod-resolver": "^1.3.0",
    "morgan": "^1.10.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router": "7.14.0",
    "remix-auth": "^4.2.0",
    "remix-auth-oauth2": "^3.4.1",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.31.1",
    "@parcel/watcher": "^2.5.6",
    "@playwright/test": "^1.58.0",
    "@react-router/dev": "7.14.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/express-serve-static-core": "^5.0.7",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/browser-playwright": "^4.0.18",
    "cross-env": "^10.0.0",
    "dependency-cruiser": "^17.3.9",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.8.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.18",
    "vitest-browser-react": "^2.0.4"
  }
}
